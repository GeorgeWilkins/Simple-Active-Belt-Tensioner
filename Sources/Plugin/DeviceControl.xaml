<UserControl
    x:Class="User.ActiveBeltTensioner.DeviceControl"
    x:Name="Interface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
    xmlns:local="clr-namespace:User.ActiveBeltTensioner"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
    xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:oxy="http://oxyplot.org/wpf"
    d:DataContext="{d:DesignInstance Type=local:DeviceViewModel}"
    mc:Ignorable="d"
>
    
    <UserControl.Resources>
        <Style x:Key="ProfileListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseLeftButtonUp" Handler="SelectProfile" />
        </Style>
        <Style x:Key="MotorTemperatureStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Padding" Value="0,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </UserControl.Resources>
    
    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="0*" />
            </Grid.ColumnDefinitions>

            <StackPanel>

                <styles:SHTabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <styles:SHTabItem Header="{SLoc SABT_Tab_Connection}" d:Header="Tab">
                        <StackPanel>
                            <styles:SHTitledGroup Title="{SLoc SABT_Title_Connection}" d:Title="Title">
                                <StackPanel>

                                    <StackPanel>
                                        <TextBlock TextWrapping="WrapWithOverflow" Margin="0,0,0,20">
                                            <Label Content="{SLoc SABT_Label_EnableMotors}" Margin="-5,0,0,0" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Plugin.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Settings.IsSerialPortValid}" />
                                            <Label Content="{SLoc SABT_Label_StartAutomatically}" Margin="-5,0,0,0" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Settings.StartAutomatically, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Label Content="{SLoc SABT_Label_FlipChannels}" Margin="-5,0,0,0" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Settings.IsFlipped, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Label Content="{SLoc SABT_Label_ReverseDirection}" Margin="-5,0,0,0" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Settings.IsReversed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="600" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Column="0" Grid.Row="0">
                                            <Image Source="{Binding MotorController.LeftMotorGraphic}" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="1"/>
                                                </Image.RenderTransform>
                                            </Image>
                                            <Image Source="{Binding MotorController.WarningGraphic}" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="1"/>
                                                </Image.RenderTransform>
                                            </Image>
                                            <TextBlock Style="{StaticResource MotorTemperatureStyle}" HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,50,62" Text="{Binding MotorController.LeftMotorTemperature, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource MotorTemperatureStyle}" HorizontalAlignment="Right" TextAlignment="Left" Margin="0,0,30,62" Text="°C" />
                                        </Grid>

                                        <Grid Grid.Column="1" Grid.Row="0">
                                            <Image Source="{Binding MotorController.RightMotorGraphic}" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="-1"/>
                                                </Image.RenderTransform>
                                            </Image>

                                            <Image Source="{Binding MotorController.WarningGraphic}" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="-1"/>
                                                </Image.RenderTransform>
                                            </Image>
                                            <TextBlock Style="{StaticResource MotorTemperatureStyle}" HorizontalAlignment="Left" TextAlignment="Right" Margin="30,0,0,62" Text="{Binding MotorController.RightMotorTemperature, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource MotorTemperatureStyle}" HorizontalAlignment="Left" TextAlignment="Left" Margin="50,0,0,62" Text="°C" />
                                        </Grid>

                                        <Image Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Source="/User.ActiveBeltTensioner;component/SABT Logo.png" Width="150" Margin="0,0,0,460"/>

                                        <styles:SHButtonPrimary Grid.Column="0" Grid.Row="2" HorizontalAlignment="Stretch" Click="TestLeftMotor" Margin="0,10,10,0" IsEnabled="{Binding MotorController.LeftMotorIsConnected}" Content="{SLoc SABT_Button_TestMotor}" />
                                        <styles:SHButtonPrimary Grid.Column="1" Grid.Row="2" HorizontalAlignment="Stretch" Click="TestRightMotor" Margin="10,10,0,0" IsEnabled="{Binding MotorController.RightMotorIsConnected}" Content="{SLoc SABT_Button_TestMotor}" />

                                        <TextBox Grid.Column="0" Grid.Row="3" Text="{Binding MotorController.LeftMotorStatus, Mode=OneWay}" Margin="1,15,10,0" IsReadOnly="True" IsEnabled="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                        <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding MotorController.RightMotorStatus, Mode=OneWay}" Margin="11,15,0,0" IsReadOnly="True" IsEnabled="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                                        <TextBlock Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" LineHeight="20" TextWrapping="WrapWithOverflow" Margin="2,50,2,20" Text="{SLoc SABT_Text_Connection}" />

                                        <ComboBox Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" ItemsSource="{Binding MotorController.SerialPorts}" SelectedItem="{Binding Settings.SerialPort, UpdateSourceTrigger=PropertyChanged}" Margin="-1,10,-1,10" />

                                        <styles:SHButtonPrimary Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Click="SetupMotors" Margin="0,0,0,0" IsEnabled="{Binding Settings.IsSerialPortValid}" Content="{SLoc SABT_Button_SetupMotors}" />

                                    </Grid>

                                </StackPanel>
                            </styles:SHTitledGroup>
                            <styles:SHTitledGroup Title="{SLoc SABT_Title_Temperatures}" d:Title="Title">
                                <StackPanel>

                                    <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Temperatures}" />

                                    <styles:SHSectionSeparator />

                                    <ui:TitledSlider Title="{SLoc SABT_Label_ReducedOutputTemperature}" Maximum="80" Minimum="45" Value="{Binding Settings.ReducedOutputTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_ReducedOutputTemperature}" />

                                    <styles:SHSectionSeparator />

                                    <ui:TitledSlider Title="{SLoc SABT_Label_StoppedOutputTemperature}" Maximum="80" Minimum="45" Value="{Binding Settings.StoppedOutputTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_StoppedOutputTemperature}" />

                                </StackPanel>
                            </styles:SHTitledGroup>
                        </StackPanel>
                    </styles:SHTabItem>
                    <styles:SHTabItem Header="{SLoc SABT_Tab_Tension}" d:Header="Tab">
                        <styles:SHTitledGroup Title="{SLoc SABT_Title_Tension}" d:Title="Title">
                            <StackPanel>

                                <ui:TitledSlider Title="{SLoc SABT_Label_IdleTension}" Maximum="250" Minimum="0" Value="{Binding Settings.IdleTension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_IdleTension}" />

                                <styles:SHSectionSeparator />

                                <ui:TitledRangeSlider Title="{SLoc SABT_Label_DrivingTension}" Maximum="1000" Minimum="0" LowerValue="{Binding Settings.MinimumTension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" UpperValue="{Binding Settings.MaximumTension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_DrivingTension}" />

                                <styles:SHSectionSeparator />

                                <ui:TitledSlider Title="{SLoc SABT_Label_LeftRightBias}" Maximum="1000" Minimum="-1000" Value="{Binding Settings.SideBias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_LeftRightBias}" />

                                <styles:SHSectionSeparator />

                                <DockPanel Margin="5,4,5,4">
                                    <mah:NumericUpDown DockPanel.Dock="Right" Width="100" Minimum="10" Maximum="200" Value="{Binding Settings.TensionStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{SLoc SABT_Label_StepSize}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_TensionStep}" />

                            </StackPanel>
                        </styles:SHTitledGroup>
                    </styles:SHTabItem>
                    <styles:SHTabItem Header="{SLoc SABT_Tab_Effects}" d:Header="Tab">
                        <StackPanel>
                            <styles:SHTitledGroup Title="{SLoc SABT_Title_Effects}" d:Title="Title">
                                <StackPanel>

                                    <ui:TitledSlider Title="{SLoc SABT_Label_Cornering}" Maximum="1000" Minimum="0" Value="{Binding Settings.CorneringStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Cornering}" />

                                    <styles:SHSectionSeparator />

                                    <ui:TitledSlider Title="{SLoc SABT_Label_Braking}" Maximum="1000" Minimum="0" Value="{Binding Settings.BrakingStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Braking}" />

                                    <styles:SHSectionSeparator />

                                    <ui:TitledSlider Title="{SLoc SABT_Label_Acceleration}" Maximum="1000" Minimum="0" Value="{Binding Settings.AccelerationStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Acceleration}" />

                                    <styles:SHSectionSeparator />

                                    <ui:TitledSlider Title="{SLoc SABT_Label_Jumping}" Maximum="1000" Minimum="0" Value="{Binding Settings.JumpingStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Jumping}" />

                                    <styles:SHSectionSeparator />

                                    <ui:TitledSlider Title="{SLoc SABT_Label_Landing}" Maximum="1000" Minimum="0" Value="{Binding Settings.LandingStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Landing}" />

                                    <styles:SHSectionSeparator />

                                    <ui:TitledSlider Title="{SLoc SABT_Label_Engine}" Maximum="1000" Minimum="0" Value="{Binding Settings.EngineStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Engine}" />

                                    <styles:SHSectionSeparator />

                                    <ui:TitledSlider Title="{SLoc SABT_Label_Upshifting}" Maximum="1000" Minimum="0" Value="{Binding Settings.UpshiftingStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Upshifting}" />

                                </StackPanel>
                            </styles:SHTitledGroup>
                        </StackPanel>
                    </styles:SHTabItem>
                    <styles:SHTabItem Header="{SLoc SABT_Tab_Tuning}" d:Header="Tab">
                        <StackPanel>
                            <styles:SHTitledGroup Title="{SLoc SABT_Title_Profiles}" d:Title="Title">
                                <StackPanel>

                                    <StackPanel>
                                        <TextBlock TextWrapping="WrapWithOverflow" Margin="0,0,0,5">
                                            <Label Content="{SLoc SABT_Label_AutomaticSwitching}" Margin="-5,0,0,0" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Settings.IsAutomaticallySwitching, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="WrapWithOverflow" Margin="0,0,0,20" LineHeight="20" Text="{SLoc SABT_Text_Profiles}" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding Settings.Profiles}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,10,0,-10" ItemContainerStyle="{StaticResource ProfileListBoxItemStyle}" MaxHeight="400" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="5" Margin="0,0,0,10" CornerRadius="5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#454545" />
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="#119eda" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Background" Value="#357c38" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="10*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="4*" />
                                                            <ColumnDefinition Width="2*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Run Text="{SLoc SABT_Prefix_Game}" d:Text="Game" FontWeight="Bold" />
                                                            <Run Text=": " FontWeight="Bold" />
                                                            <Run Text="{Binding GameLabel, Mode=OneTime}" />
                                                            <Run Text=" > " />
                                                            <Run Text="{SLoc SABT_Prefix_Vehicle}" d:Text="Vehicle" FontWeight="Bold" />
                                                            <Run Text=": " FontWeight="Bold" />
                                                            <Run Text="{Binding VehicleLabel, Mode=OneTime}" />
                                                        </TextBlock>

                                                        <Button Grid.Column="1" Content="{SLoc SABT_Button_CopyForGame}" Margin="0,0,10,0" Click="DuplicateProfileForCurrentGame" Tag="{Binding}" />
                                                        <Button Grid.Column="2" Content="{SLoc SABT_Button_CopyForGameAndVehicle}" Margin="0,0,10,0"
                                                                Click="DuplicateProfileForCurrentGameAndVehicle" Tag="{Binding}"
                                                                IsEnabled="{Binding DataContext.Plugin.HasCurrentVehicle, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                                        <Button Grid.Column="3" Content="{SLoc SABT_Button_Delete}" Margin="0" Click="DeleteProfile" Tag="{Binding}" IsEnabled="{Binding IsNotDefault, Mode=OneTime}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </styles:SHTitledGroup>
                            <styles:SHTitledGroup Title="{SLoc SABT_Title_Tuning}" d:Title="Title">
                                <StackPanel>

                                    <StackPanel>
                                        <TextBlock TextWrapping="WrapWithOverflow" Margin="0,0,0,5">
                                            <Label Content="{SLoc SABT_Label_AutomaticTuning}" Margin="-5,0,0,0" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Plugin.IsAutomaticallyTuning, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Label Content="{SLoc SABT_Label_EnableMotors}" Margin="-5,0,0,0" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Plugin.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Settings.IsSerialPortValid}" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="WrapWithOverflow" Margin="0,0,0,20" LineHeight="20" Text="{SLoc SABT_Text_Tuning}" />
                                    </StackPanel>

                                    <oxy:PlotView Height="700" HorizontalAlignment="Stretch" Margin="-14,-10,-14,15" Background="#202020" Model="{Binding TelemetryGraphModel}" />

                                    <StackPanel Orientation="Horizontal" Margin="-14,-15,-14,14" Background="#202020">
                                        <StackPanel Orientation="Horizontal" Margin="50,0,0,15">
                                            <Label Content="{SLoc SABT_Legend_Surge}" d:Content="Plot" Foreground="#f44336" VerticalAlignment="Center" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Settings.ShowSurgePlot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <Label Content="{SLoc SABT_Legend_Sway}" d:Content="Plot" Foreground="#4caf50" VerticalAlignment="Center" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Settings.ShowSwayPlot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <Label Content="{SLoc SABT_Legend_Heave}" d:Content="Plot" Foreground="#ffeb3b" VerticalAlignment="Center" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Settings.ShowHeavePlot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <Label Content="{SLoc SABT_Legend_Torque}" d:Content="Plot" Foreground="#119eda" VerticalAlignment="Center" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Settings.ShowTorquePlot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <ui:TitledRangeSlider Title="{SLoc SABT_Label_SurgeLimits}" Maximum="50" Minimum="-50" LowerValue="{Binding Settings.MinimumSurge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" UpperValue="{Binding Settings.MaximumSurge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Plugin.IsNotAutomaticallyTuning}" />
                                    <ui:TitledRangeSlider Title="{SLoc SABT_Label_SwayLimits}" Maximum="50" Minimum="-50" LowerValue="{Binding Settings.MinimumSway, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" UpperValue="{Binding Settings.MaximumSway, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Plugin.IsNotAutomaticallyTuning}" />
                                    <ui:TitledRangeSlider Title="{SLoc SABT_Label_HeaveLimits}" Maximum="100" Minimum="-50" LowerValue="{Binding Settings.MinimumHeave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" UpperValue="{Binding Settings.MaximumHeave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Plugin.IsNotAutomaticallyTuning}" />

                                    <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Telemetry}" />

                                    <styles:SHSectionSeparator />

                                    <ui:TitledSlider Title="{SLoc SABT_Label_SmoothingFactor}" Maximum="750" Minimum="0" Value="{Binding Settings.SmoothingFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Smoothing}" />

                                </StackPanel>
                            </styles:SHTitledGroup>
                        </StackPanel>
                    </styles:SHTabItem>
                    <styles:SHTabItem Header="{SLoc SABT_Tab_Credits}" d:Header="Tab">
                        <styles:SHTitledGroup Title="{SLoc SABT_Title_Credits}" d:Title="Title">
                            <StackPanel>

                                <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="10">
                                    <Image Source="/User.ActiveBeltTensioner;component/GW Logo.png" Width="105" Margin="-3,0,0,8"/>
                                    <LineBreak />
                                    <Run Text="{SLoc SABT_Text_Designer}" />
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://georgewilkins.co.uk" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_Website}" /></Hyperlink>
                                    <LineBreak />
                                    <Hyperlink NavigateUri="mailto:sabt@georgewilkins.co.uk" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_Email}" /></Hyperlink>
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://github.com/GeorgeWilkins" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_GitHubProfile}" /></Hyperlink>
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://github.com/GeorgeWilkins/Simple-Active-Belt-Tensioner/blob/main/LICENSE.md" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_ProjectLicense}" /></Hyperlink>
                                    <LineBreak />
                                    <LineBreak />
                                    <Run Text="{SLoc SABT_Text_SimHub}" />
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://github.com/SHWotever/SimHub/wiki/Plugin-and-extensions-SDKs" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_SDKDocumentation}" /></Hyperlink>
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://github.com/SHWotever" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_GitHubProfile}" /></Hyperlink>
                                    <LineBreak />
                                    <LineBreak />
                                    <Run Text="{SLoc SABT_Text_Tester}" />
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://github.com/turtlemenace" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_GitHubProfile}" /></Hyperlink>
                                    <LineBreak />
                                    <LineBreak />
                                    <iconpacks:PackIconMaterial Grid.Column="0" Width="25" Height="25" Margin="0,0,0,8" Kind="GithubBox" />
                                    <LineBreak />
                                    <Run Text="{SLoc SABT_Text_Repository}" />
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://github.com/GeorgeWilkins/Simple-Active-Belt-Tensioner" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_GitHubRepository}" /></Hyperlink>
                                </TextBlock>

                            </StackPanel>
                        </styles:SHTitledGroup>
                    </styles:SHTabItem>
                </styles:SHTabControl>


            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>