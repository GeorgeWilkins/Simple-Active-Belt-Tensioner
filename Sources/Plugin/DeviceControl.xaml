<UserControl
    x:Class="User.ActiveBeltTensioner.DeviceControl"
    x:Name="Interface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
    xmlns:local="clr-namespace:User.ActiveBeltTensioner"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
    xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:oxy="http://oxyplot.org/wpf"
    d:DataContext="{d:DesignInstance Type=local:DeviceViewModel}"
    mc:Ignorable="d"
>
    
    <UserControl.Resources>

        <local:ThousandthsToPercentConverter x:Key="ThousandthsToPercentConverter" />

        <Style x:Key="ProfileListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseLeftButtonUp" Handler="SelectProfile" />
        </Style>
        
        <Style x:Key="MotorTemperatureStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Padding" Value="0,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="SettingStyle" TargetType="ContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border x:Name="ContentBorder" BorderBrush="#292929" BorderThickness="2" CornerRadius="5" Background="#333333" Padding="8,8,8,4" Margin="0,10,0,0">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="ExperimentalIndicator" BorderThickness="0" CornerRadius="0,0,5,5" Background="#FFC107" Padding="0,0,0,0" Margin="0,10,60,0" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="{SLoc SABT_Tooltip_Experimental}">
                                <StackPanel Orientation="Horizontal">
                                    <iconpacks:PackIconMaterial Kind="AlertRhombus" Width="14" Height="14" Foreground="#202020" VerticalAlignment="Center" Margin="5,2,0,2" />
                                    <TextBlock Text="{SLoc SABT_Label_Experimental}" Foreground="#202020" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,0" Padding="5,2,6,4" FontSize="10" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Experimental">
                                <Setter TargetName="ExperimentalIndicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="#FFC107" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Darker">
                                <Setter TargetName="ContentBorder" Property="Background" Value="#202020" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    
    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="0*" />
            </Grid.ColumnDefinitions>

            <StackPanel>

                <styles:SHTabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <styles:SHTabItem Header="{SLoc SABT_Tab_Connection}" d:Header="Tab">
                        <StackPanel>
                            <styles:SHTitledGroup Title="{SLoc SABT_Title_Connection}" d:Title="Title">
                                <StackPanel>

                                    <StackPanel>
                                        <TextBlock TextWrapping="WrapWithOverflow" Margin="0,0,0,20">
                                            <Label Content="{SLoc SABT_Label_EnableMotors}" Margin="-5,0,0,0" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Plugin.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Settings.IsSerialPortValid}" />
                                            <Label Content="{SLoc SABT_Label_StartAutomatically}" Margin="-5,0,0,0" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Settings.StartAutomatically, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Label Content="{SLoc SABT_Label_FlipChannels}" Margin="-5,0,0,0" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Settings.IsFlipped, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Label Content="{SLoc SABT_Label_ReverseDirection}" Margin="-5,0,0,0" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Settings.IsReversed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="600" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Column="0" Grid.Row="0">
                                            <Image Source="{Binding MotorController.LeftMotorGraphic}" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="1"/>
                                                </Image.RenderTransform>
                                            </Image>
                                            <Image Source="{Binding MotorController.WarningGraphic}" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="1"/>
                                                </Image.RenderTransform>
                                            </Image>
                                            <TextBlock Style="{StaticResource MotorTemperatureStyle}" HorizontalAlignment="Right" TextAlignment="Center" Margin="0,0,35,62" Text="{Binding MotorController.LeftMotorTemperature, Mode=OneWay, StringFormat={}{0}°C, TargetNullValue=-}" />
                                        </Grid>

                                        <Grid Grid.Column="1" Grid.Row="0">
                                            <Image Source="{Binding MotorController.RightMotorGraphic}" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="-1"/>
                                                </Image.RenderTransform>
                                            </Image>

                                            <Image Source="{Binding MotorController.WarningGraphic}" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="-1"/>
                                                </Image.RenderTransform>
                                            </Image>
                                            <TextBlock Style="{StaticResource MotorTemperatureStyle}" HorizontalAlignment="Left" TextAlignment="Center" Margin="35,0,0,62" Text="{Binding MotorController.RightMotorTemperature, Mode=OneWay, StringFormat={}{0}°C, TargetNullValue=-}" />
                                        </Grid>

                                        <Image Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Source="/User.ActiveBeltTensioner;component/SABT Logo.png" Width="150" Margin="0,0,0,460"/>

                                        <styles:SHButtonPrimary Grid.Column="0" Grid.Row="2" HorizontalAlignment="Stretch" Click="TestLeftMotor" Margin="0,10,10,0" IsEnabled="{Binding MotorController.LeftMotorIsConnected}" Content="{SLoc SABT_Button_TestMotor}" />
                                        <styles:SHButtonPrimary Grid.Column="1" Grid.Row="2" HorizontalAlignment="Stretch" Click="TestRightMotor" Margin="10,10,0,0" IsEnabled="{Binding MotorController.RightMotorIsConnected}" Content="{SLoc SABT_Button_TestMotor}" />

                                        <TextBox Grid.Column="0" Grid.Row="3" Text="{Binding MotorController.LeftMotorStatus, Mode=OneWay}" Margin="1,15,10,0" IsReadOnly="True" IsEnabled="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                        <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding MotorController.RightMotorStatus, Mode=OneWay}" Margin="11,15,0,0" IsReadOnly="True" IsEnabled="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                                        <TextBlock Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" LineHeight="20" TextWrapping="WrapWithOverflow" Margin="2,15,2,5" Text="{SLoc SABT_Text_Connection}" />

                                        <ComboBox Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" ItemsSource="{Binding MotorController.SerialPorts}" SelectedItem="{Binding Settings.SerialPort, UpdateSourceTrigger=PropertyChanged}" Margin="-1,10,-1,10" />

                                        <styles:SHButtonPrimary Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Click="SetupMotors" Margin="0,0,0,0" IsEnabled="{Binding Settings.IsSerialPortValid}" Content="{SLoc SABT_Button_SetupMotors}" />

                                    </Grid>

                                </StackPanel>
                            </styles:SHTitledGroup>
                            <styles:SHTitledGroup Title="{SLoc SABT_Title_Diagnostics}" d:Title="Title">
                                <StackPanel>

                                    <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Diagnostics}" />

                                    <Grid Margin="5,10,5,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{SLoc SABT_Label_Motor}" />
                                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{SLoc SABT_Label_LowestTemperature}" />
                                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{SLoc SABT_Label_HighestTemperature}" />
                                        <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{SLoc SABT_Label_MostConsecutiveFaults}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding MotorController.Motors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="5,5,5,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Identifier, StringFormat=ID {0}}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding LowestTemperature, StringFormat={}{0}°C, TargetNullValue=-}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding HighestTemperature, StringFormat={}{0}°C, TargetNullValue=-}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding MostConsecutiveFaults}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <styles:SHButtonPrimary HorizontalAlignment="Stretch" Click="ResetDiagnostics" Margin="0,20,0,0" Content="{SLoc SABT_Button_ResetDiagnostics}" />

                                </StackPanel>
                            </styles:SHTitledGroup>
                        </StackPanel>
                    </styles:SHTabItem>
                    <styles:SHTabItem Header="{SLoc SABT_Tab_Preferences}" d:Header="Tab">
                        <styles:SHTitledGroup Title="{SLoc SABT_Title_Preferences}" d:Title="Title">
                            <StackPanel>

                                <StackPanel>
                                    <TextBlock TextWrapping="WrapWithOverflow" Margin="0,0,0,0" LineHeight="20" Text="{SLoc SABT_Text_Preferences}" />
                                </StackPanel>

                                <ContentControl Style="{StaticResource SettingStyle}">
                                    <StackPanel>
                                        <local:SettingSlider Title="{SLoc SABT_Label_IdleTension}" Unit="%" Minimum="0" Maximum="25" Step="0.1" Value="{Binding Settings.IdleTension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThousandthsToPercentConverter}}" />
                                        <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_IdleTension}" />
                                    </StackPanel>
                                </ContentControl>

                                <ContentControl Style="{StaticResource SettingStyle}">
                                    <StackPanel>
                                        <local:SettingRangeSlider Grid.Column="0" Title="{SLoc SABT_Label_DrivingTension}" Unit="%" Minimum="0" Maximum="100" Step="0.1" LeftValue="{Binding Settings.MinimumTension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThousandthsToPercentConverter}}" RightValue="{Binding Settings.MaximumTension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThousandthsToPercentConverter}}" />
                                        <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_DrivingTension}" />
                                    </StackPanel>
                                </ContentControl>

                                <ContentControl Style="{StaticResource SettingStyle}">
                                    <StackPanel>
                                        <DockPanel Margin="5,4,5,4">
                                            <mah:NumericUpDown DockPanel.Dock="Right" Width="100" Minimum="10" Maximum="200" Value="{Binding Settings.TensionStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{SLoc SABT_Label_StepSize}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_TensionStep}" />
                                    </StackPanel>
                                </ContentControl>

                                <ContentControl Style="{StaticResource SettingStyle}">
                                    <StackPanel>
                                        <local:SettingSlider Title="{SLoc SABT_Label_LeftRightBias}" Unit="%" Minimum="-100" Maximum="100" Step="0.1" Value="{Binding Settings.SideBias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThousandthsToPercentConverter}}" />
                                        <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_LeftRightBias}" />
                                    </StackPanel>
                                </ContentControl>

                                <ContentControl Style="{StaticResource SettingStyle}">
                                    <StackPanel>
                                        <local:SettingRangeSlider Grid.Column="0" Title="{SLoc SABT_Label_TemperatureThrottlingRange}" Unit="°C" Minimum="0" Maximum="80" Step="1" Midpoint="50" LeftValue="{Binding Settings.ReducedOutputTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RightValue="{Binding Settings.StoppedOutputTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_TemperatureThrottlingRange}" />
                                    </StackPanel>
                                </ContentControl>

                            </StackPanel>
                        </styles:SHTitledGroup>
                    </styles:SHTabItem>
                    <styles:SHTabItem Header="{SLoc SABT_Tab_Profiles}" d:Header="Tab">
                        <StackPanel>
                            <styles:SHTitledGroup Title="{SLoc SABT_Title_Profiles}" d:Title="Title">
                                <StackPanel>

                                    <StackPanel>
                                        <TextBlock TextWrapping="WrapWithOverflow" Margin="0,0,0,5">
                                            <Label Content="{SLoc SABT_Label_AutomaticSwitching}" Margin="-5,0,0,0" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Settings.IsAutomaticallySwitching, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="WrapWithOverflow" Margin="0,0,0,5" LineHeight="20" Text="{SLoc SABT_Text_Profiles}" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding Settings.Profiles}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,10,0,-10" ItemContainerStyle="{StaticResource ProfileListBoxItemStyle}" MaxHeight="400" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="5" Margin="0,0,0,10" CornerRadius="5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#454545" />
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="#119eda" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Background" Value="#357c38" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="10*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="4*" />
                                                            <ColumnDefinition Width="2*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Run Text="{SLoc SABT_Prefix_Game}" d:Text="Game" FontWeight="Bold" />
                                                            <Run Text=": " FontWeight="Bold" />
                                                            <Run Text="{Binding GameLabel, Mode=OneTime}" />
                                                            <Run Text=" > " />
                                                            <Run Text="{SLoc SABT_Prefix_Vehicle}" d:Text="Vehicle" FontWeight="Bold" />
                                                            <Run Text=": " FontWeight="Bold" />
                                                            <Run Text="{Binding VehicleLabel, Mode=OneTime}" />
                                                        </TextBlock>

                                                        <Button Grid.Column="1" Content="{SLoc SABT_Button_CopyForGame}" Margin="0,0,10,0" Click="DuplicateProfileForCurrentGame" Tag="{Binding}" />
                                                        <Button Grid.Column="2" Content="{SLoc SABT_Button_CopyForGameAndVehicle}" Margin="0,0,10,0"
                                                                Click="DuplicateProfileForCurrentGameAndVehicle" Tag="{Binding}"
                                                                IsEnabled="{Binding DataContext.Plugin.HasCurrentVehicle, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                                        <Button Grid.Column="3" Content="{SLoc SABT_Button_Delete}" Margin="0" Click="DeleteProfile" Tag="{Binding}" IsEnabled="{Binding IsNotDefault, Mode=OneTime}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </styles:SHTitledGroup>
                            <styles:SHTitledGroup Title="{SLoc SABT_Title_Tuning}" d:Title="Title">
                                <StackPanel>

                                    <StackPanel>
                                        <TextBlock TextWrapping="WrapWithOverflow" Margin="0,0,0,5">
                                            <Label Content="{SLoc SABT_Label_AutomaticTuning}" Margin="-5,0,0,0" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Plugin.IsAutomaticallyTuning, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Label Content="{SLoc SABT_Label_EnableMotors}" Margin="-5,0,0,0" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding Plugin.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Settings.IsSerialPortValid}" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="WrapWithOverflow" Margin="0,0,0,5" LineHeight="20" Text="{SLoc SABT_Text_Tuning}" />
                                    </StackPanel>

                                    <ContentControl Style="{StaticResource SettingStyle}" Tag="Darker">
                                        <StackPanel>

                                            <oxy:PlotView Height="{Binding Settings.TelemetryGraphHeight, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="-5,-5,-5,0" Background="#202020" Model="{Binding TelemetryGraphModel}" />

                                            <Thumb x:Name="TelemetryGraphResizeHandle" Height="14" HorizontalAlignment="Stretch" Margin="0,0,0,0" Background="#202020" Cursor="SizeNS" DragDelta="ResizeTelemetryGraph">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{TemplateBinding Background}">
                                                            <Rectangle Height="3" Width="32" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#808080" RadiusX="1.5" RadiusY="1.5" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" Margin="45,0,0,0">
                                                    <Label Content="{SLoc SABT_Legend_Surge}" d:Content="Plot" Foreground="#f44336" VerticalAlignment="Center" />
                                                    <styles:SHToggleCheckbox IsChecked="{Binding Settings.ShowSurgePlot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                    <Label Content="{SLoc SABT_Legend_Sway}" d:Content="Plot" Foreground="#4caf50" VerticalAlignment="Center" />
                                                    <styles:SHToggleCheckbox IsChecked="{Binding Settings.ShowSwayPlot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                    <Label Content="{SLoc SABT_Legend_Heave}" d:Content="Plot" Foreground="#ffeb3b" VerticalAlignment="Center" />
                                                    <styles:SHToggleCheckbox IsChecked="{Binding Settings.ShowHeavePlot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                    <Label Content="{SLoc SABT_Legend_Torque}" d:Content="Plot" Foreground="#119eda" VerticalAlignment="Center" />
                                                    <styles:SHToggleCheckbox IsChecked="{Binding Settings.ShowTorquePlot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </StackPanel>

                                        </StackPanel>
                                    </ContentControl>

                                    <ContentControl Style="{StaticResource SettingStyle}">
                                        <StackPanel>
                                            <local:SettingRangeSlider Grid.Column="0" Title="{SLoc SABT_Label_SurgeLimits}" Unit="m/s²" Minimum="-50" Maximum="50" Step="0.1" LeftValue="{Binding Settings.MinimumSurge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RightValue="{Binding Settings.MaximumSurge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <local:SettingRangeSlider Grid.Column="0" Title="{SLoc SABT_Label_SwayLimits}" Unit="m/s²" Minimum="-50" Maximum="50" Step="0.1" LeftValue="{Binding Settings.MinimumSway, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RightValue="{Binding Settings.MaximumSway, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ShouldMirror="True" />
                                            <local:SettingRangeSlider Grid.Column="0" Title="{SLoc SABT_Label_HeaveLimits}" Unit="m/s²" Minimum="-50" Maximum="100" Step="0.1" LeftValue="{Binding Settings.MinimumHeave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RightValue="{Binding Settings.MaximumHeave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Telemetry}" />
                                        </StackPanel>
                                    </ContentControl>

                                    <ContentControl Style="{StaticResource SettingStyle}">
                                        <StackPanel>
                                            <local:SettingSlider Title="{SLoc SABT_Label_SmoothingFactor}" Unit="%" Minimum="0" Maximum="75" Step="0.1" Value="{Binding Settings.SmoothingFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThousandthsToPercentConverter}}" />
                                            <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Smoothing}" />
                                        </StackPanel>
                                    </ContentControl>
                                    
                                    <ContentControl Style="{StaticResource SettingStyle}">
                                        <StackPanel>
                                            <local:SettingSlider Title="{SLoc SABT_Label_Cornering}" Unit="%" Minimum="0" Maximum="100" Step="0.1" Value="{Binding Settings.CorneringStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThousandthsToPercentConverter}}" />
                                            <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Cornering}" />
                                        </StackPanel>
                                    </ContentControl>

                                    <ContentControl Style="{StaticResource SettingStyle}">
                                        <StackPanel>
                                            <local:SettingSlider Title="{SLoc SABT_Label_Braking}" Unit="%" Minimum="0" Maximum="100" Step="0.1" Value="{Binding Settings.BrakingStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThousandthsToPercentConverter}}" />
                                            <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Braking}" />
                                        </StackPanel>
                                    </ContentControl>

                                    <ContentControl Style="{StaticResource SettingStyle}">
                                        <StackPanel>
                                            <local:SettingSlider Title="{SLoc SABT_Label_Acceleration}" Unit="%" Minimum="0" Maximum="100" Step="0.1" Value="{Binding Settings.AccelerationStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThousandthsToPercentConverter}}" />
                                            <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Acceleration}" />
                                        </StackPanel>
                                    </ContentControl>

                                    <ContentControl Style="{StaticResource SettingStyle}">
                                        <StackPanel>
                                            <local:SettingSlider Title="{SLoc SABT_Label_Jumping}" Unit="%" Minimum="0" Maximum="100" Step="0.1" Value="{Binding Settings.JumpingStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThousandthsToPercentConverter}}" />
                                            <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Jumping}" />
                                        </StackPanel>
                                    </ContentControl>

                                    <ContentControl Style="{StaticResource SettingStyle}">
                                        <StackPanel>
                                            <local:SettingSlider Title="{SLoc SABT_Label_Landing}" Unit="%" Minimum="0" Maximum="100" Step="0.1" Value="{Binding Settings.LandingStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThousandthsToPercentConverter}}" />
                                            <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Landing}" />
                                        </StackPanel>
                                    </ContentControl>

                                    <ContentControl Style="{StaticResource SettingStyle}" Tag="Experimental">
                                        <StackPanel>
                                            <local:SettingSlider Title="{SLoc SABT_Label_Engine}" Unit="%" Minimum="0" Maximum="100" Step="0.1" Value="{Binding Settings.EngineStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThousandthsToPercentConverter}}" />
                                            <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,5" Text="{SLoc SABT_Text_Engine}" />
                                        </StackPanel>
                                    </ContentControl>

                                    <ContentControl Style="{StaticResource SettingStyle}" Tag="Experimental">
                                        <StackPanel>
                                            <local:SettingSlider Title="{SLoc SABT_Label_Upshifting}" Unit="%" Minimum="0" Maximum="100" Step="0.1" Value="{Binding Settings.UpshiftingStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThousandthsToPercentConverter}}" />
                                            <Grid Margin="0,0,-1,10">
                                                <TextBox Text="{Binding Settings.UpshiftingModifiers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4,4,26,4" />
                                                <TextBlock Text="&#10003;" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Settings.AreUpshiftingModifiersValid}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="&#10007;" FontWeight="Bold" Foreground="#F44336" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Settings.AreUpshiftingModifiersValid}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="5,0,0,0" Text="{SLoc SABT_Text_Upshifting}" />
                                            <styles:SHButtonPrimary HorizontalAlignment="Stretch" Click="ResetUpshiftingModifiers" Margin="0,10,0,5" Content="{SLoc SABT_Button_ResetUpshiftingModifiers}" />
                                        </StackPanel>
                                    </ContentControl>

                                </StackPanel>
                            </styles:SHTitledGroup>
                        </StackPanel>
                    </styles:SHTabItem>
                    <styles:SHTabItem Header="{SLoc SABT_Tab_Credits}" d:Header="Tab">
                        <styles:SHTitledGroup Title="{SLoc SABT_Title_Credits}" d:Title="Title">
                            <StackPanel>

                                <TextBlock LineHeight="20" TextWrapping="WrapWithOverflow" Margin="10">
                                    <Image Source="/User.ActiveBeltTensioner;component/GW Logo.png" Width="105" Margin="-3,0,0,8"/>
                                    <LineBreak />
                                    <Run Text="{SLoc SABT_Text_Designer}" />
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://georgewilkins.co.uk" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_Website}" /></Hyperlink>
                                    <LineBreak />
                                    <Hyperlink NavigateUri="mailto:sabt@georgewilkins.co.uk" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_Email}" /></Hyperlink>
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://github.com/GeorgeWilkins" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_GitHubProfile}" /></Hyperlink>
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://github.com/GeorgeWilkins/Simple-Active-Belt-Tensioner/blob/main/LICENSE.md" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_ProjectLicense}" /></Hyperlink>
                                    <LineBreak />
                                    <LineBreak />
                                    <Run Text="{SLoc SABT_Text_SimHub}" />
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://github.com/SHWotever/SimHub/wiki/Plugin-and-extensions-SDKs" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_SDKDocumentation}" /></Hyperlink>
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://github.com/SHWotever" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_GitHubProfile}" /></Hyperlink>
                                    <LineBreak />
                                    <LineBreak />
                                    <Run Text="{SLoc SABT_Text_Tester}" />
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://github.com/turtlemenace" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_GitHubProfile}" /></Hyperlink>
                                    <LineBreak />
                                    <LineBreak />
                                    <iconpacks:PackIconMaterial Grid.Column="0" Width="25" Height="25" Margin="0,0,0,8" Kind="GithubBox" />
                                    <LineBreak />
                                    <Run Text="{SLoc SABT_Text_Repository}" />
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://github.com/GeorgeWilkins/Simple-Active-Belt-Tensioner" Click="OpenHyperlink"><Run Text="{SLoc SABT_Link_GitHubRepository}" /></Hyperlink>
                                </TextBlock>

                            </StackPanel>
                        </styles:SHTitledGroup>
                    </styles:SHTabItem>
                </styles:SHTabControl>


            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>