<UserControl
    x:Class="User.ActiveBeltTensioner.SettingRangeSlider"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:User.ActiveBeltTensioner"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="{Binding Title, ElementName=Root}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Unit, ElementName=Root}" Foreground="#AAAAAA" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,0,0,0" />
            <TextBlock x:Name="RightValueTextBlock" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,0,1,0" />
            <TextBlock Text="~" Foreground="#AAAAAA" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="1,0,1,0" />
            <TextBlock x:Name="LeftValueTextBlock" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,0,1,0" />
        </DockPanel>

        <mah:RangeSlider Grid.Row="1"
            x:Name="RangeSliderControl"
            Minimum="{Binding Minimum, ElementName=Root}"
            Maximum="{Binding Maximum, ElementName=Root}"
            LowerValue="{Binding LeftValue, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            UpperValue="{Binding RightValue, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            SmallChange="{Binding Step, ElementName=Root}"
            LargeChange="{Binding Step, ElementName=Root}"
            MinRangeWidth="10"
            IsSnapToTickEnabled="True" />
    </Grid>
</UserControl>
